Total Reported Cases =
SUM(Weekly[weekly_cases])

Total Reported Deaths =
SUM(Weekly[weekly_deaths])

Average Weekly Cases per Million =
AVERAGE(Weekly[weekly_cases_per_million])

Average Weekly Deaths per Million =
AVERAGE(Weekly[weekly_deaths_per_million])

Peak Weekly Cases per Million =
MAX(Weekly[weekly_cases_per_million])

Peak Weekly Deaths per Million =
MAX(Weekly[weekly_deaths_per_million])

Average 4W Cases per Million =
AVERAGE(Weekly[cases_4w_avg_per_million])

Countries =
DISTINCTCOUNT(Weekly[iso_code])

Average Reporting Coverage % =
AVERAGE(CountrySummary[row_coverage_pct])
